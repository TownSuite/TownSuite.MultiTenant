<Project>
  <PropertyGroup>
      <AssemblyVersion>26.2.1</AssemblyVersion>
      <FileVersion>26.2.1</FileVersion>
      <Version>26.2.1</Version>
      <Deterministic>true</Deterministic>
      <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
      <Company>TownSuite Municipal Software Inc.</Company>
      <Product>TownSuite MultiTenant</Product>
      <Copyright>Copyright © TownSuite Municipal Software Inc. 2026</Copyright>
      <Description>A small dotnet library to assist in single instance applications with multi tenant databases.</Description>
      <IsPackable>false</IsPackable>
  </PropertyGroup>
   <PropertyGroup Condition=" '$(NUGET_CONFIG_FILE)' != '' ">
    <RestoreConfigFile>$(NUGET_CONFIG_FILE)</RestoreConfigFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
